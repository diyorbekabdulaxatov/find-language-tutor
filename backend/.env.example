# Copy to .env for local development. cmd/api and the other binaries load .env
# automatically when it exists.

APP_ENV=development
PORT=8080

# Comma-separated. The Next.js dev server runs on :3000.
ALLOWED_ORIGINS=http://localhost:3000

# Matches docker-compose.yml
DATABASE_URL=postgres://findtutor:findtutor@localhost:5432/findtutor?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Auth. Access tokens are HS256 JWTs signed with AUTH_JWT_SECRET; refresh tokens
# are opaque and stored (hashed) in the sessions table.
# In development a built-in insecure secret is used if AUTH_JWT_SECRET is unset;
# production requires it.
AUTH_JWT_SECRET=
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h
# Refresh-cookie domain: leave empty in dev. Secure flag defaults to on outside
# development; override with AUTH_COOKIE_SECURE=true|false.
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=

SHUTDOWN_TIMEOUT=10s

# Payments. "fake" is the only provider for the MVP (Stripe does not operate in
# Uzbekistan; a real Payme / Click / Uzum adapter drops in behind the same
# port later). PAYMENTS_WEBHOOK_SECRET, when set, is the HMAC-SHA256 key the
# POST /v1/payments/webhook handler verifies against the X-Payment-Signature
# header; leave empty in dev to disable verification.
PAYMENTS_PROVIDER=fake
PAYMENTS_WEBHOOK_SECRET=

# Email (booking confirmations / cancellations + lesson reminders sent by the
# worker). Leave RESEND_API_KEY empty in dev — a logging emailer is used that
# just prints to / subject / first body line at INFO. Set it to a Resend API
# key in production to actually send. EMAIL_FROM is the From header.
RESEND_API_KEY=
EMAIL_FROM=findtutor <noreply@findtutor.local>
