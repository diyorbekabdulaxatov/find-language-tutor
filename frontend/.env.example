# Base URL of the Go backend (internal/api), used by server components.
API_URL=http://localhost:8080

# Same backend, but read in the browser (login form, auth refresh, dashboard
# writes). Must be reachable from the user's browser and must be listed in the
# backend's ALLOWED_ORIGINS for the credentialed refresh cookie to flow.
NEXT_PUBLIC_API_URL=http://localhost:8080
